# Desarrollo local. Copiar como .env y no versionar el archivo resultante.
SPRING_PROFILES_ACTIVE=demo
TZ=UTC

DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestion_servicios_db
DB_USER=app_servicios
DB_PASSWORD=dev_app_password
DB_ROOT_PASSWORD=dev_root_password
FLYWAY_USER=app_servicios
FLYWAY_PASSWORD=dev_app_password

SERVER_PORT=8080
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=30000

# Valor local únicamente. Cambiarlo si se añade autenticación real.
JWT_SECRET=dev-only-secret-change-me-012345678901234567890123456789
JWT_EXPIRATION_MINUTES=480
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_EMAIL_DOMAIN=universidad.edu

STORAGE_PATH=./storage/evidencias
MAX_FILE_SIZE_MB=5
OTEL_SERVICE_NAME=servicios-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Requeridas al usar SPRING_PROFILES_ACTIVE=demo; usar solo una contraseña ficticia local
DEMO_USER_PASSWORD=demo-password
# Opcional: 200 por defecto; usar 2000 para pruebas de carga
DEMO_SOLICITUDES=200

FRONTEND_PORT=81